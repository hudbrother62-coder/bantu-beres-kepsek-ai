# Optional overrides. The connected Supabase URL and publishable key are safe
# browser configuration and already have production fallbacks in lib/public-config.js.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Gemini server-only authorization keys. Leave blank to keep AI disabled.
GEMINI_AUTH_KEY_1=
GEMINI_AUTH_KEY_2=
GEMINI_AUTH_KEY_3=

# Stable defaults at the time this repository was created. Override without
# changing source code when Google updates model aliases.
GEMINI_PRIMARY_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Maximum uploaded file sent inline for AI extraction (bytes)
MAX_INLINE_FILE_BYTES=3000000
