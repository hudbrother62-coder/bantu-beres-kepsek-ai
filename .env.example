# Public Supabase settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# GroqCloud server-side keys. Gemini keys are no longer used.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# GROQ_API_KEY can be used as an alias for slot 1.
# Supported text/vision models are detected automatically from GroqCloud.
MAX_INLINE_FILE_BYTES=3000000

# Keep the same encryption secret used before the migration, so existing records remain decryptable.
BYOK_ENCRYPTION_KEY=
